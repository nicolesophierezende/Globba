---
// Home page: the map app. Markup and styles are the same as the original index.html.
import css from '../styles/app.css?raw';
import HeadExtras from '../components/HeadExtras.astro';
import { loadData } from '../lib/data.js';
import { SITE, paths } from '../config.js';
const data = await loadData();
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---
<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Globba – negozi internazionali a Torino</title>
<HeadExtras title="Globba – negozi internazionali a Torino" description={SITE.description.it} alternates={{ it: '/', en: '/?lang=en' }} />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/MarkerCluster.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700;12..96,800&display=swap" rel="stylesheet">
<style is:inline set:html={css}></style>
</head>
<body>
<div class="app" id="app">
  <main>
    <div class="mapbox" id="map" aria-label="Mappa">
      <div id="lmap"></div>
      <button class="resetbtn" id="reset" aria-label="Torino">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg></button>
      <div class="mapmsg" id="mapmsg" hidden role="status"></div>
      <button class="nearbtn" id="near">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
        <span id="nearlbl"></span>
      </button>
      <div class="toast" id="toast" role="status" aria-live="polite"></div>
    </div>
    <div class="side">
      <header class="top">
        <div>
          <div class="logo" aria-label="Globba">Gl<span class="o" aria-hidden="true"></span>bba</div>
          <div class="tagline" id="tagline"></div>
        </div>
        <div class="lang" role="group" aria-label="Lingua / Language">
          <button data-l="it">IT</button><button data-l="en">EN</button>
        </div>
      </header>
      <div class="searchwrap">
        <label class="search">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.5-4.5"/></svg>
          <input id="q" type="search" autocomplete="off" enterkeyhint="search">
          <button class="iconbtn" id="qclear" hidden aria-label="×"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
        </label>
      </div>
      <div class="chips" id="chips" role="group"></div>
      <section class="panel" id="panel" aria-live="polite"></section>
    </div>
  </main>
</div>

<div class="scrim" id="scrim"></div>
<aside class="sheet" id="sheet" role="dialog" aria-modal="false" aria-labelledby="sheettitle"></aside>
<noscript><p style="padding:16px"><a href={paths.stores('it')}>Tutti i negozi</a> · <a href={paths.products('it')}>Tutti i prodotti</a> · <a href={paths.privacy('it')}>Privacy</a></p></noscript>

<script is:inline type="application/json" id="globba-data" set:html={json}></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet.markercluster/1.5.3/leaflet.markercluster.js"></script>
<script>import '../scripts/app.js';</script>
</body>
</html>
