# Copy this file to ".env" and fill in the values. Never commit .env.
# Without Supabase values, the site runs with the invented sample stores.

# Supabase → Project Settings → API (or "Connect"): Project URL and the anon / publishable key.
# The anon key is meant to be public; your data is protected by the rules in supabase/schema.sql.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Public address of the site (Netlify sets this automatically; only needed elsewhere).
SITE_URL=

# Privacy policy details (shown on /privacy/).
PUBLIC_CONTACT_EMAIL=
PUBLIC_OWNER_NAME=

# Optional: GoatCounter code for cookie-free visit statistics (https://www.goatcounter.com).
PUBLIC_GOATCOUNTER_CODE=
